# EXEMPLE SEULEMENT : ce fichier n'est jamais appliqué avec kubectl.
# Le vrai Secret est créé par scripts/create-secrets.ps1 avec des valeurs aléatoires.
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: student-enrollment
type: Opaque
stringData:
  DB_PASSWORD: "CHANGE_ME_exemple"
  JWT_SECRET: "CHANGE_ME_exemple_au_moins_32_caracteres"