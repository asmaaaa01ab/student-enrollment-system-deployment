# Copier ce fichier en .env (déjà ignoré par Git) et remplacer les valeurs.
DB_PASSWORD=change-me-strong-password
# Au moins 32 caractères
JWT_SECRET=change-me-with-at-least-32-characters-long

# URLs PUBLIQUES (vues par le navigateur). En cloud : IP/domaine du serveur.
GATEWAY_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:8084

# Options JVM (optionnel)
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
